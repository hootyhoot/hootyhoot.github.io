---
layout: default
---
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">status // online <span class="zulu-clock" id="zulu-clock">{{ 'now' | date: '%d%H%M' }}Z</span></p>
    <h1 class="hero-name">
      {% if site.title == 'blank' %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% else %}{{ site.title }}{% endif %}
    </h1>
    {% if site.data.resume.about.title %}
      <p class="hero-title">{{ site.data.resume.about.title }}</p>
    {% endif %}
  </div>

  {% if page.profile.image %}
    <div class="hero-photo">
      <img src="{{ page.profile.image | prepend: 'assets/img/' | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
    </div>
  {% endif %}
</section>

{% if site.data.resume.about %}
  <div class="status-strip">
    <p class="status-strip-code">
      WMKK/KUL
      {{ site.data.resume.about.title | upcase | replace: ' ', '-' }}
      @{{ site.data.resume.work.first.name | upcase | replace: ' ', '-' }} IFR
    </p>
    <div class="status-strip-decode">{{ content }}</div>
  </div>
{% else %}
  <div class="bio">{{ content }}</div>
{% endif %}

{% if page.news and site.news != blank %}
  <section class="log-section">
    <div class="section-heading">
      <h2>log &middot; news</h2>
      <a class="section-link" href="{{ '/news/' | relative_url }}">full log &rarr;</a>
    </div>
    {% include news.liquid limit=true %}
  </section>
{% endif %}

{% if page.social %}
  <section class="social-section">
    <p class="eyebrow">channels</p>
    <ul class="social-list">{% include social.liquid %}</ul>
  </section>
{% endif %}
