<section id="graph"><div class="wrap">
  <h2>A year in blocks</h2>
  <p class="intro">Every day I committed is a block. The greener, the more I shipped.</p>
  <figure class="graph box">
    <canvas id="contrib" role="img" aria-label="GitHub contributions in the last year"></canvas>
    <figcaption><span><a href="https://github.com/hootyhoot" target="_blank" rel="noopener">@hootyhoot</a> <span id="total">· loading…</span></span><span id="day"></span></figcaption>
  </figure>
</div></section>

<section id="log"><div class="wrap">
  <h2>Log</h2>
  <ol class="log">
    <li class="box"><time>Jul 2026</time><div><b>Started at WyseTime Technologies</b><p>Joined as an embedded systems engineer in Kuala Lumpur.</p></div></li>
