<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mikhail Armanuel</title>
<meta name="description" content="Mikhail Armanuel: embedded systems engineer at WyseTime Technologies, Kuala Lumpur.">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="canonical" href="https://mikhail.codes/">
<script data-cfasync="false">
  (function () {
    var t = null;
    try { t = localStorage.getItem('theme'); } catch (e) {}
    document.documentElement.setAttribute('data-theme', t || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Silkscreen&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0c0d0b; --bg-2:#141512; --shadow:#2c2e29;
  --ink:#eceee6; --ink-2:#d9dcd2; --muted:#8d9288;
  --build:#5ce483; --agent:#d97757; --sky:#6fb7ff;
  --surface-2:#1b1d19; --cloud:#1a1c18; --ground-2:#232520; --ground-top:#3a8f53;
  --build-deep:#1f6b37; --agent-deep:#8f4d36; --sky-deep:#3e6f9e; --amber:#e5c07b;
  --g0:#1b1d19; --g1:#1f5a33; --g2:#2f8a4c; --g3:#45b96a; --g4:#5ce483;
  color-scheme:dark;
}
:root[data-theme="light"]{
  --bg:#f3eedd; --bg-2:#fffbf0; --shadow:#c9bc93;
  --ink:#2b2418; --ink-2:#4a4030; --muted:#6b6046;
  --build:#2f8a4c; --agent:#b85a3a; --sky:#2e6e8e;
  --surface-2:#eae2c8; --cloud:#e6dec4; --ground-2:#ddd3b3; --ground-top:#2f8a4c;
  --build-deep:#1f5a33; --agent-deep:#7a3a24; --sky-deep:#1d4a60; --amber:#b8862b;
  --g0:#e4dcc1; --g1:#b5dfb9; --g2:#7cc48a; --g3:#45a35e; --g4:#2b7a41;
  color-scheme:light;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:"Silkscreen",monospace;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
img{image-rendering:pixelated}
.mono{font-family:"JetBrains Mono",monospace}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
section{position:relative;padding:120px 0 40px}
h2{font-size:clamp(28px,4vw,40px);font-weight:400;margin-bottom:40px;display:flex;align-items:center;gap:16px}
h2::before{content:"";width:16px;height:16px;background:var(--build);box-shadow:4px 4px 0 var(--shadow)}

/* pixel box: hard offset shadow, square corners */
.box{background:var(--bg-2);border:2px solid var(--shadow);box-shadow:6px 6px 0 var(--shadow)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 22px;background:var(--build);color:var(--bg);text-decoration:none;font-size:15px;box-shadow:6px 6px 0 var(--build-deep);transition:transform .08s steps(2),box-shadow .08s steps(2)}
.btn:hover{transform:translate(3px,3px);box-shadow:3px 3px 0 var(--build-deep)}
.btn:active{transform:translate(6px,6px);box-shadow:0 0 0 var(--build-deep)}

/* nav */
header{position:fixed;inset:0 0 auto 0;z-index:40;display:flex;justify-content:space-between;align-items:center;padding:20px 32px;background:var(--bg);border-bottom:2px solid var(--shadow)}
header .name{text-decoration:none;font-size:15px}
header nav{display:flex;gap:28px;font-size:13px;align-items:center}
header nav a{text-decoration:none;color:var(--muted)}
header nav a:hover{color:var(--build)}
@media (max-width:640px){header nav a:not(.gh){display:none}}
.theme{width:34px;height:34px;display:grid;place-items:center;background:var(--bg-2);border:2px solid var(--shadow);box-shadow:3px 3px 0 var(--shadow);color:var(--ink);cursor:pointer;transition:transform .08s steps(2),box-shadow .08s steps(2)}
.theme:hover{border-color:var(--build)}
.theme:active{transform:translate(3px,3px);box-shadow:none}
.theme svg{width:16px;height:16px;shape-rendering:crispEdges}
.theme .moon{display:none}
:root[data-theme="light"] .theme .sun{display:none}
:root[data-theme="light"] .theme .moon{display:block}

/* hero */
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding-top:80px;overflow:hidden}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hero .wrap{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero h1{font-size:clamp(32px,6vw,100px);font-weight:400;line-height:1.1;margin:0 -24px 28px;display:flex;flex-wrap:wrap;justify-content:center;column-gap:.5em;user-select:none}
@media (max-width:640px){.hero h1{font-size:13vw}}
.hero h1 .word{display:flex;white-space:nowrap}
/* outer span: drop in, then bob forever in a wave; inner span: hover/click effects */
/* per-letter delays are set inline from JS (drop, then bob) */
.hero h1 .l{display:inline-block;opacity:0;animation:drop .5s steps(6) forwards,bob 1.8s steps(6) infinite}
.hero h1 .l i{display:inline-block;font-style:normal;cursor:pointer;transition:transform .1s steps(2),color .1s steps(2)}
.hero h1 .l i:hover{transform:translateY(-14px);color:var(--build)}
.hero h1 .l i.kick{animation:kick .6s steps(8)}
@keyframes drop{from{opacity:0;transform:translateY(-120px)}to{opacity:1;transform:none}}
@keyframes bob{0%,100%{opacity:1;transform:translateY(0)}50%{opacity:1;transform:translateY(-10px)}}
@keyframes kick{0%{transform:none;color:var(--build)}30%{transform:translateY(-60px) rotate(180deg) scale(1.2);color:var(--agent)}60%{transform:translateY(-20px) rotate(330deg);color:var(--sky)}100%{transform:none}}
.hero .line{font-family:"JetBrains Mono",monospace;font-size:clamp(15px,2vw,19px);line-height:1.7;color:var(--ink-2);max-width:640px;margin:0 auto 36px;opacity:0;animation:fade .4s steps(4) 1.4s forwards}
.hero .line{position:relative;z-index:10}
.hero .ctas,.hero .socials{position:relative;z-index:1}
.hero .line a{text-decoration:none;border-bottom:2px dashed currentColor;position:relative}
.hero .line .w{color:var(--build)} .hero .line .u{color:var(--agent)}
.hero .ctas,.hero .socials{opacity:0;animation:fade .4s steps(4) 1.7s forwards}
@keyframes fade{to{opacity:1}}
.socials{display:flex;gap:24px;list-style:none;margin-top:40px;font-size:13px}
.socials a{text-decoration:none;color:var(--muted)}
.socials a:hover{color:var(--ink)}
.ground{position:absolute;left:0;right:0;bottom:0;height:24px;background:repeating-linear-gradient(90deg,var(--shadow) 0 24px,var(--ground-2) 24px 48px);z-index:1}
.ground::before{content:"";position:absolute;inset:-6px 0 auto 0;height:6px;background:var(--ground-top)}
/* hover tooltip card */
.tip{position:absolute;left:50%;margin-left:-130px;text-align:left;top:calc(100% + 12px);width:260px;padding:14px;font-size:12px;line-height:1.5;color:var(--ink);opacity:0;pointer-events:none;transform:translateY(-6px);transition:opacity .12s steps(2),transform .12s steps(2);z-index:5;border-color:var(--accent)}
.tip b{display:block;color:var(--accent);font-weight:400;margin-bottom:4px}
.hero .line a:hover .tip{opacity:1;transform:none}
.hero .socials{justify-content:center}
.hint{font-size:10px;color:var(--muted);margin:-14px 0 28px;opacity:0;animation:fade .4s steps(4) 2.2s forwards}

/* projects */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px}
.card{display:flex;flex-direction:column;text-decoration:none;transition:transform .1s steps(2)}
.card:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--build)}
.card .media{aspect-ratio:16/9;background:var(--surface-2);overflow:hidden;border-bottom:2px solid var(--shadow);position:relative}
.card .media img{width:100%;height:100%;object-fit:cover;image-rendering:auto;filter:saturate(.85)}
.card .media .glyph{position:absolute;inset:0;display:grid;place-items:center;font-size:44px;color:var(--build)}
.card .body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:10px;flex:1}
.card h3{font-size:19px;font-weight:400}
.card p{font-family:"JetBrains Mono",monospace;font-size:13px;color:var(--ink-2);line-height:1.55}
.card .meta{margin-top:auto;display:flex;justify-content:space-between;font-size:11px;color:var(--muted);padding-top:8px}
.card .meta .tag{color:var(--bg);background:var(--muted);padding:2px 6px}
.card .meta .tag.school{background:var(--sky)} .card .meta .tag.personal{background:var(--agent)}

/* about / player card */
.narrow{max-width:820px;margin:0 auto}
.player{display:grid;grid-template-columns:220px 1fr;gap:32px;padding:28px;align-items:start}
@media (max-width:640px){.player{grid-template-columns:1fr}}
.portrait{border:2px solid var(--shadow);background:var(--surface-2);line-height:0}
.portrait img{width:100%;height:auto}
.stats .top{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:10px}
.stats .lvl{color:var(--bg);background:var(--build);padding:2px 8px}
.stats h3{font-size:26px;font-weight:400}
.stats .cls{font-size:13px;color:var(--agent);margin:4px 0 22px}
.label{font-size:11px;color:var(--muted);margin-bottom:8px;letter-spacing:.06em}
.items{list-style:none;margin-bottom:22px}
.items li{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:2px dotted var(--shadow);font-size:13px}
.items li span:last-child{color:var(--build);text-align:right}
.bars{display:grid;grid-template-columns:auto 1fr;gap:8px 14px;align-items:center;font-size:12px;margin-bottom:22px}
.bar{height:12px;background:repeating-linear-gradient(90deg,var(--build) 0 10px,transparent 10px 12px);width:0;transition:width 1.2s steps(14)}
.bar.go{width:var(--v)}
.move{font-family:"JetBrains Mono",monospace;font-size:14px;line-height:1.6;color:var(--ink-2)}

/* contribution graph */
.intro{font-family:"JetBrains Mono",monospace;color:var(--ink-2);margin:-20px 0 28px;font-size:14px;line-height:1.6}
.graph{padding:20px;overflow-x:auto}
.graph canvas{display:block}
.graph figcaption{display:flex;justify-content:space-between;margin-top:14px;font-size:12px;color:var(--muted);gap:12px;flex-wrap:wrap}
.graph figcaption a{color:var(--build);text-decoration:none}

/* log */
.log{list-style:none;display:flex;flex-direction:column;gap:18px;max-width:820px}
.log li{padding:18px 20px;display:grid;grid-template-columns:120px 1fr;gap:16px;align-items:baseline}
.log time{font-size:12px;color:var(--muted)}
.log b{font-weight:400;font-size:16px;display:block;margin-bottom:6px}
.log p{font-family:"JetBrains Mono",monospace;font-size:13px;color:var(--ink-2);line-height:1.55}
@media (max-width:640px){.log li{grid-template-columns:1fr}}

/* contact */
.cols{display:grid;grid-template-columns:1fr 1.4fr;gap:40px;align-items:start}
@media (max-width:800px){.cols{grid-template-columns:1fr}}
.links{list-style:none;display:flex;flex-direction:column;gap:14px}
.links a{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;text-decoration:none;font-size:14px}
.links a:hover{border-color:var(--build)}
.links .h{font-family:"JetBrains Mono",monospace;color:var(--muted);font-size:13px}
.term .bar-top{display:flex;align-items:center;gap:14px;padding:10px 14px;border-bottom:2px solid var(--shadow);font-size:11px;color:var(--muted)}
.dots{display:flex;gap:6px}.dots i{width:10px;height:10px;background:var(--shadow)}
.dots i:first-child{background:var(--agent)}.dots i:nth-child(2){background:var(--amber)}.dots i:last-child{background:var(--build)}
.screen{font-family:"JetBrains Mono",monospace;font-size:13px;line-height:1.7;padding:16px;height:300px;overflow-y:auto}
.screen p{white-space:pre-wrap}
.screen .ok{color:var(--build)} .screen .err{color:var(--agent)} .screen .dim{color:var(--muted)}
.screen a{color:var(--sky)}
.prompt{display:flex;gap:8px}
.prompt .ps1{color:var(--build)}
.prompt input{flex:1;background:none;border:0;outline:0;color:var(--ink);font:inherit;caret-color:var(--build)}
.chips{display:flex;gap:10px;padding:0 16px 16px;flex-wrap:wrap}
.chip{font-family:"Silkscreen",monospace;font-size:11px;background:var(--shadow);color:var(--ink);border:0;padding:8px 12px;cursor:pointer}
.chip:hover{background:var(--build);color:var(--bg)}

footer{padding:80px 0 40px;font-size:12px;color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}

/* companion plane */
#plane{position:fixed;z-index:30;pointer-events:none;left:0;top:0;transform-origin:center;filter:drop-shadow(3px 3px 0 var(--shadow))}
.bubble{position:fixed;z-index:31;font-size:11px;background:var(--ink);color:var(--bg);padding:6px 9px;pointer-events:none;opacity:0;transition:opacity .15s steps(2);white-space:nowrap}
.bubble::after{content:"";position:absolute;left:10px;bottom:-6px;border:6px solid transparent;border-top-color:var(--ink);border-bottom:0}

@media (prefers-reduced-motion:reduce){
  .hero h1 .l,.hint,.hero .line,.hero .ctas,.hero .socials{animation:none;opacity:1;transform:none}
  #plane,.bubble{display:none}
}
</style>
</head>
