<script data-cfasync="false">
// ---------- theme ----------
const cssVar = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
document.getElementById('theme').addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('theme', next); } catch (e) {}
  dispatchEvent(new Event('themechange'));
});

// ---------- hero title: words of letters, each clickable ----------
const title = document.getElementById('title');
let li = 0;
'Mikhail Armanuel'.split(' ').forEach(word => {
  const w = document.createElement('span');
  w.className = 'word';
  for (const ch of word) {
    const l = document.createElement('span');
    l.className = 'l';
    const d = li*70 + 200;
    l.style.animationDelay = `${d}ms, ${d + 600 + li*40}ms`;
    li++;
    l.setAttribute('aria-hidden', 'true');
    const inner = document.createElement('i');
    inner.textContent = ch;
    inner.addEventListener('click', () => {
      inner.classList.remove('kick'); void inner.offsetWidth; inner.classList.add('kick');
      const r = inner.getBoundingClientRect();
      if (window.spawnBlocks) window.spawnBlocks(r.left + r.width/2, r.top + r.height/2, 10);
    });
    inner.addEventListener('animationend', () => inner.classList.remove('kick'));
    l.appendChild(inner);
    w.appendChild(l);
  }
  title.appendChild(w);
});

document.getElementById('lvl').textContent = `Lvl ${new Date().getFullYear() - 2003}`;

// ---------- hero sky: drifting pixel clouds + blocks that fall and pile on the ground ----------
(() => {
  const c = document.getElementById('sky'), x = c.getContext('2d');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const P = 8, tones = ['build', 'agent', 'sky', 'ink'];
  const deep = {build: '--build-deep', agent: '--agent-deep', sky: '--sky-deep', ink: '--muted'};
  let pal;
  const loadPal = () => {
    pal = {cloud: cssVar('--cloud')};
    for (const t of tones) { pal[t] = cssVar('--' + t); pal[t + '-d'] = cssVar(deep[t]); }
  };
  loadPal(); addEventListener('themechange', () => { loadPal(); if (reduce) frame(); });
  let W, H, clouds = [], blocks = [], piles = {};
  function size() {
    W = c.width = c.offsetWidth; H = c.height = c.offsetHeight;
    clouds = Array.from({length: 7}, () => ({x: Math.random()*W, y: Math.random()*H*0.55, w: 3+Math.random()*6|0, v: .15+Math.random()*.3}));
    // drop blocks that are now off-screen, re-stack the rest in place
    blocks = blocks.filter(b => b.x <= W - P);
    restack();
  }
  // rebuild column heights from landed blocks (after a resize or trimming old blocks)
  function restack() {
    piles = {};
    const ground = H - 24 - 6;
    blocks.filter(b => b.landed).sort((a, b) => b.y - a.y).forEach(b => {
      const col = b.x/P|0;
      b.y = ground - P - (piles[col] || 0)*P;
      piles[col] = (piles[col] || 0) + 1;
    });
  }
  addEventListener('resize', size);
  const spawn = (px, py, n, tone) => {
    for (let k = 0; k < n; k++) blocks.push({
      x: px, y: py, vx: (Math.random() - .5)*10, vy: -4 - Math.random()*8,
      tone: tone || tones[Math.random()*tones.length|0], landed: false,
    });
    if (blocks.length > 400) { blocks.splice(0, blocks.length - 400); restack(); }
  };
  size();
  // intro: blocks rain down onto the ground
  for (let i = 0; i < 40; i++) spawn(Math.random()*innerWidth, -40 - i*30, 1, 'build');
  blocks.forEach(b => { b.vx = 0; b.vy = 0; });
  window.spawnBlocks = (cx, cy, n) => {
    const r = c.getBoundingClientRect();
    spawn(cx - r.left, cy - r.top, n);
    if (reduce) frame();
  };
  function frame() {
    x.clearRect(0, 0, W, H);
    x.fillStyle = pal.cloud;
    for (const cl of clouds) {
      for (let i = 0; i < cl.w; i++) x.fillRect((cl.x + i*P)|0, cl.y|0, P, P);
      for (let i = 1; i < cl.w-1; i++) x.fillRect((cl.x + i*P)|0, (cl.y-P)|0, P, P);
      cl.x += cl.v; if (cl.x > W) cl.x = -cl.w*P;
    }
    const ground = H - 24 - 6;
    for (const b of blocks) {
      if (!b.landed) {
        b.vy += .6; b.x += b.vx; b.y += b.vy; b.vx *= .98;
        if (b.x < 0 || b.x > W - P) { b.vx *= -1; b.x = Math.max(0, Math.min(W - P, b.x)); }
        const col = b.x/P|0, floor = ground - P - (piles[col] || 0)*P;
        if (b.y >= floor) { b.y = floor; b.x = col*P; b.landed = true; piles[col] = (piles[col] || 0) + 1; }
      }
      x.fillStyle = pal[b.landed ? b.tone + '-d' : b.tone];
      x.fillRect(b.x|0, b.y|0, P, P);
    }
    if (!reduce) requestAnimationFrame(frame);
  }
  frame();
})();

// ---------- stat bars ----------
new IntersectionObserver((es, o) => es.forEach(e => {
  if (e.isIntersecting) { e.target.querySelectorAll('.bar').forEach(b => b.classList.add('go')); o.disconnect(); }
}), {threshold: .4}).observe(document.querySelector('.player'));

// ---------- contribution graph ----------
(async () => {
  const c = document.getElementById('contrib'), x = c.getContext('2d');
  let colors;
  const loadColors = () => { colors = [0, 1, 2, 3, 4].map(i => cssVar('--g' + i)); };
  loadColors();
  const S = 12, G = 3;
  let days = [];
  try {
    const r = await fetch('https://github-contributions-api.jogruber.de/v4/hootyhoot?y=last');
    const d = await r.json();
    days = d.contributions;
    document.getElementById('total').textContent = `· ${d.total.lastYear.toLocaleString()} contributions in the last year`;
  } catch (e) {
    document.getElementById('total').textContent = '· offline';
    return;
  }
  const offset = new Date(days[0].date).getDay();
  const cols = Math.ceil((days.length + offset) / 7);
  const dpr = devicePixelRatio || 1;
  c.width = cols*(S+G)*dpr; c.height = 7*(S+G)*dpr;
  c.style.width = cols*(S+G) + 'px'; c.style.height = 7*(S+G) + 'px';
  x.scale(dpr, dpr);
  const pos = days.map((d, i) => Object.assign({}, d, {cx: ((i+offset)/7|0)*(S+G), cy: ((i+offset)%7)*(S+G)}));
  // blocks "fall" into place column by column
  let t = 0;
  function draw() {
    x.clearRect(0, 0, c.width, c.height);
    let done = true;
    for (const p of pos) {
      const delay = p.cx/(S+G)*1.2;
      const k = Math.min(1, Math.max(0, (t - delay)/10));
      if (k < 1) done = false;
      if (k <= 0) continue;
      const y = p.cy - (1-k)*(1-k)*60;
      x.fillStyle = colors[p.level];
      x.fillRect(p.cx, Math.round(y/3)*3, S, S);
    }
    t++;
    if (!done) requestAnimationFrame(draw);
  }
  new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { draw(); o.disconnect(); } }, {threshold: .3}).observe(c);
  addEventListener('themechange', () => { loadColors(); t = Math.max(t, 1e4); draw(); });
  c.addEventListener('mousemove', e => {
    const r = c.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top;
    const p = pos.find(p => mx >= p.cx && mx < p.cx+S && my >= p.cy && my < p.cy+S);
    document.getElementById('day').textContent = p ? `${p.count} on ${p.date}` : '';
  });
})();

// ---------- terminal ----------
(() => {
  const out = document.getElementById('out'), inp = document.getElementById('cmd'), scr = document.getElementById('screen');
  const say = (html, cls = '') => { const p = document.createElement('p'); p.className = cls; p.innerHTML = html; out.appendChild(p); scr.scrollTop = scr.scrollHeight; };
  const cmds = {
    help: () => say('commands: <span class="ok">whoami</span>, <span class="ok">email</span>, <span class="ok">projects</span>, <span class="ok">github</span>, <span class="ok">cv</span>, <span class="ok">clear</span>'),
    whoami: () => say('mikhail armanuel. embedded systems engineer @ wysetime.\nkuala lumpur, MY. nottingham CS. flies sims, builds things.'),
    email: () => { say('opening mail client → <a href="mailto:mail@mikhail.codes">mail@mikhail.codes</a>', 'ok'); location.href = 'mailto:mail@mikhail.codes'; },
    projects: () => say('asemboi  book-recommend  nand2tetris  sdxl  metarbot\n→ <a href="#projects">scroll up</a>'),
    github: () => { say('→ <a href="https://github.com/hootyhoot" target="_blank">github.com/hootyhoot</a>', 'ok'); },
    cv: () => say('→ <a href="/cv/">/cv</a>', 'ok'),
    clear: () => { out.innerHTML = ''; },
    sudo: () => say('nice try.', 'err'),
  };
  const run = line => {
    say(`<span class="ok">guest ~ $</span> ${line.replace(/</g, '&lt;')}`);
    const [c, ...a] = line.trim().split(/\s+/);
    if (!c) return;
    (cmds[c.toLowerCase()] || (() => say(`command not found: ${c.replace(/</g, '&lt;')}. try "help"`, 'err')))(a);
  };
  ["hi. this is mikhail's terminal.", 'type a command and press enter,', 'or just use the buttons below.'].forEach(l => say(l, 'dim'));
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') { run(inp.value); inp.value = ''; } });
  document.querySelectorAll('.chip').forEach(b => b.onclick = () => run(b.dataset.c));
})();

// ---------- companion: a little pixel plane that follows the cursor ----------
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(pointer: coarse)').matches) {
    document.getElementById('plane').style.display = 'none'; return;
  }
  const c = document.getElementById('plane'), x = c.getContext('2d'), bub = document.getElementById('bubble');
  // side-view airliner, nose to the right. T tail, F fuselage, o cabin windows,
  // K cockpit glass, S cheatline stripe, B belly, W wing, E engine
  const sprite = [
    'TTT.........................',
    'TTTT........................',
    '.TTTT.......................',
    '.TTTTT......................',
    '..TTTTFFFFFFFFFFFFFFFFFFF...',
    '..FFFFFoFoFoFoFoFoFoFoFFKKF.',
    '..FFFFFFFFFFFFFFFFFFFFFFFFFF',
    '...SSSSSSSSSSSSSSSSSSSSSSSS.',
    '....BBBBBBBBBBBBBBBBBBBBBB..',
    '..........WWWWWWWWW.........',
    '............WEEEEW..........',
    '..............EE............',
  ];
  const pal = {T: '#d97757', F: '#eceee6', o: '#2c2e29', K: '#6fb7ff', S: '#5ce483', B: '#c4c8bc', W: '#8d9288', E: '#5d6159'};
  const PX = 3;
  sprite.forEach((row, y) => [...row].forEach((ch, i) => { if (pal[ch]) { x.fillStyle = pal[ch]; x.fillRect(i*PX, y*PX, PX, PX); } }));
  let px = innerWidth - 120, py = 120, tx = px, ty = py, flip = false;
  addEventListener('mousemove', e => { tx = e.clientX + 28; ty = e.clientY - 34; });
  const lines = {
    projects: ['Cleared for takeoff.', 'Five projects, zero crashes.', 'nand2tetris: NAND all the way down.'],
    about: ['Player 1, ready.', 'Lvl up pending.'],
    graph: ['Green means go.', 'Commit, climb, cruise.'],
    log: ['Flight log updated.'],
    contact: ['Type "help".', 'Tower, this is guest…'],
  };
  let current = '', hideT;
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting || e.target.id === current || !lines[e.target.id]) return;
    current = e.target.id;
    const l = lines[current];
    bub.textContent = l[Math.random()*l.length|0];
    bub.style.opacity = 1; clearTimeout(hideT); hideT = setTimeout(() => bub.style.opacity = 0, 2600);
  }), {threshold: .4});
  document.querySelectorAll('section[id]').forEach(s => io.observe(s));
  // contrail: little squares left behind the tail that fade out
  const puff = document.createElement('div');
  puff.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:29';
  document.body.appendChild(puff);
  let frameN = 0;
  (function tick() {
    const dx = tx - px, dy = ty - py;
    px += dx*.05; py += dy*.05;
    if (Math.abs(dx) > 6) flip = dx < 0;
    const tilt = Math.round(Math.max(-12, Math.min(12, dy*.15))/4)*4 * (flip ? -1 : 1);
    const sx = Math.round(px/3)*3, sy = Math.round(py/3)*3 + Math.round(Math.sin(Date.now()/400))*3;
    c.style.transform = `translate(${sx}px,${sy}px) scaleX(${flip ? -1 : 1}) rotate(${tilt}deg)`;
    bub.style.transform = `translate(${sx + 10}px,${sy - 28}px)`;
    if (++frameN % 5 === 0 && Math.hypot(dx, dy) > 20) {
      const d = document.createElement('i');
      const tailX = flip ? sx + 84 : sx, tailY = sy + 10;
      d.style.cssText = `position:absolute;left:${tailX}px;top:${tailY}px;width:6px;height:6px;background:var(--muted);opacity:.5;transition:opacity 1s steps(4),transform 1s steps(4)`;
      puff.appendChild(d);
      requestAnimationFrame(() => { d.style.opacity = 0; d.style.transform = 'scale(2)'; });
      setTimeout(() => d.remove(), 1000);
    }
    requestAnimationFrame(tick);
  })();
})();
</script>
