---
layout: default
---
<header class="page-header">
  {% if page.eyebrow %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
  <h1>{{ page.title }}</h1>
  {% if page.description %}
    <p class="page-description{% if page.collection == 'projects' %} page-description--accent{% endif %}">{{ page.description }}</p>
  {% endif %}
</header>

<article>{{ content }}</article>
