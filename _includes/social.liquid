{% if site.email %}
  <li><a href="mailto:{{ site.email }}">{% include icon.liquid name="email" %}email</a></li>
{% endif %}
{% if site.github_username %}
  <li><a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer">{% include icon.liquid name="github" %}github</a></li>
{% endif %}
{% if site.linkedin_username %}
  <li><a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" target="_blank" rel="noopener noreferrer">{% include icon.liquid name="external" %}linkedin</a></li>
{% endif %}
