<ul class="reference-list">
  {% for content in data[1] %}
    <li class="reference-item">
      <p class="reference-name">{{ content.name }}</p>
      <p class="reference-org">{{ content.reference }}</p>
      {% if content.email %}<a class="reference-email" href="mailto:{{ content.email }}">{{ content.email }}</a>{% endif %}
    </li>
  {% endfor %}
</ul>
