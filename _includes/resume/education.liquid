<ul class="flight-log">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="log-entry">
      <div class="log-date">
        {% if content.startDate and content.startDate != '' %}
          {{ content.startDate | date: '%Y.%m' }}<br>
          &ndash; {{ content.endDate | date: '%Y.%m' | default: 'now' }}
        {% endif %}
      </div>
      <div class="log-content">
        {% if content.url %}
          <a class="log-title" href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.studyType }}</a>
        {% else %}
          <span class="log-title">{{ content.studyType }}</span>
        {% endif %}
        <p class="log-sub">
          {{ content.institution }}{% if content.location %} &middot; {{ content.location }}{% endif %}
          {% if content.area %} &middot; {{ content.area }}{% endif %}
        </p>
        {% if content.courses %}
          <ul class="tag-list">
            {% for item in content.courses %}<li class="tag">{{ item }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
