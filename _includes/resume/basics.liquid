<dl class="cv-basics">
  {% assign skip_basics = 'image,profiles,location,name,title' | split: ',' %}
  {% for content in data[1] %}
    {% if content[1] == "" or skip_basics contains content[0] %}{% continue %}{% endif %}
    <dt>{{ content[0] }}</dt>
    <dd>
      {% if content[0] == 'url' %}
        <a href="{{ content[1] }}" target="_blank" rel="noopener noreferrer">{{ content[1] }}</a>
      {% elsif content[0] == 'email' %}
        <a href="mailto:{{ content[1] }}">{{ content[1] }}</a>
      {% elsif content[0] == 'phone' %}
        <a href="tel:{{ content[1] }}">{{ content[1] }}</a>
      {% else %}
        {{ content[1] }}
      {% endif %}
    </dd>
  {% endfor %}
</dl>
