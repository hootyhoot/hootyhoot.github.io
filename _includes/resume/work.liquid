<ul class="flight-log">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="log-entry">
      <div class="log-date">
        {% if content.startDate %}
          {{ content.startDate | date: '%Y.%m' }}<br>
          &ndash; {{ content.endDate | date: '%Y.%m' | default: 'now' }}
        {% endif %}
      </div>
      <div class="log-content">
        {% if content.url %}
          <a class="log-title" href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.position }}</a>
        {% else %}
          <span class="log-title">{{ content.position }}</span>
        {% endif %}
        <p class="log-sub">{{ content.name }}{% if content.location %} &middot; {{ content.location }}{% endif %}</p>
        {% if content.summary %}<p class="log-summary">{{ content.summary }}</p>{% endif %}
        {% if content.highlights %}
          <ul class="tag-list">
            {% for item in content.highlights %}<li class="tag">{{ item }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
