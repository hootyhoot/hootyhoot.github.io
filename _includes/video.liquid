<figure>
  <video
    src="{{ include.path | relative_url }}"
    style="width:100%; height:auto; border-radius: var(--radius); border: 1px solid var(--border);"
    {% if include.autoplay %}autoplay{% endif %}
    {% if include.controls %}controls{% endif %}
    {% if include.loop %}loop{% endif %}
    {% if include.muted or include.autoplay %}muted{% endif %}
    playsinline
  ></video>
</figure>
