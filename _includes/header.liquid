<header class="site-header">
  <nav class="navbar" id="navbar">
    {% assign about_title = 'about' %}
    {% for p in site.pages %}
      {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
    {% endfor %}

    <div class="nav-panel" id="nav-panel">
      <a class="nav-btn" href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>{{ about_title }}</a>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav %}
          <a class="nav-btn" href="{{ p.url | relative_url }}" {% if page.url == p.url %}aria-current="page"{% endif %}>{{ p.title }}</a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="navbar-controls">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
        <span class="icon-sun">{% include icon.liquid name="sun" %}</span>
        <span class="icon-moon">{% include icon.liquid name="moon" %}</span>
      </button>
      <button class="nav-toggle" id="nav-toggle" type="button" aria-controls="nav-panel" aria-expanded="false" aria-label="Toggle navigation">
        {% include icon.liquid name="menu" %}
      </button>
    </div>
  </nav>
</header>
