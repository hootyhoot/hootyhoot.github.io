<header class="site-header">
  <nav class="navbar" id="navbar">
    <a class="nav-name" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
    <div class="nav-panel" id="nav-panel">
      <a class="nav-btn" href="{{ '/#projects' | relative_url }}">Projects</a>
      <a class="nav-btn" href="{{ '/#about' | relative_url }}">About</a>
      <a class="nav-btn" href="{{ '/#graph' | relative_url }}">Blocks</a>
      <a class="nav-btn" href="{{ '/#log' | relative_url }}">Log</a>
      <a class="nav-btn" href="{{ '/#contact' | relative_url }}">Contact</a>
      <a class="nav-btn nav-btn--keep" href="{{ '/cv/' | relative_url }}" {% if page.url == '/cv/' %}aria-current="page"{% endif %}>CV</a>
      <a class="nav-btn" href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener">GitHub ↗</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light/dark mode" title="Toggle light/dark mode">
        <svg class="icon-sun" viewBox="0 0 16 16" fill="currentColor"><rect x="6" y="6" width="4" height="4"/><rect x="7" y="1" width="2" height="3"/><rect x="7" y="12" width="2" height="3"/><rect x="1" y="7" width="3" height="2"/><rect x="12" y="7" width="3" height="2"/><rect x="3" y="3" width="2" height="2"/><rect x="11" y="3" width="2" height="2"/><rect x="3" y="11" width="2" height="2"/><rect x="11" y="11" width="2" height="2"/></svg>
        <svg class="icon-moon" viewBox="0 0 16 16" fill="currentColor"><rect x="6" y="2" width="5" height="2"/><rect x="4" y="4" width="4" height="2"/><rect x="3" y="6" width="4" height="4"/><rect x="4" y="10" width="4" height="2"/><rect x="6" y="12" width="7" height="2"/><rect x="11" y="10" width="3" height="2"/></svg>
      </button>
    </div>
  </nav>
</header>
