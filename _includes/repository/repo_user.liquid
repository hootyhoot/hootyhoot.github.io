<div class="repo-panel">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="repo-stat-img"
      alt="{{ include.username }}"
      loading="lazy"
      data-src-light="https://github-stats-git-main-mikhail-codes.vercel.app/api/?username={{ include.username }}&show_icons=true&hide_border=true&bg_color=f3eedd&title_color=2e6e8e&icon_color=3f7d4a&text_color=2b2418"
      data-src-dark="https://github-stats-git-main-mikhail-codes.vercel.app/api/?username={{ include.username }}&show_icons=true&hide_border=true&bg_color=0b0e13&title_color=4fd8e0&icon_color=4cd787&text_color=dce6e2"
    >
  </a>
</div>
