{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo-panel">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="repo-stat-img"
      alt="{{ include.repository }}"
      loading="lazy"
      data-src-light="https://github-stats-git-main-mikhail-codes.vercel.app/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&show_owner={{ show_owner }}&hide_border=true&bg_color=f3eedd&title_color=2e6e8e&icon_color=3f7d4a&text_color=2b2418"
      data-src-dark="https://github-stats-git-main-mikhail-codes.vercel.app/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&show_owner={{ show_owner }}&hide_border=true&bg_color=0b0e13&title_color=4fd8e0&icon_color=4cd787&text_color=dce6e2"
    >
  </a>
</div>
