{% if site.news != blank %}
  {% assign news = site.news | reverse %}
  {% assign news_size = news | size %}
  {% if include.limit %}
    {% assign news_limit = site.announcements.limit | default: 5 %}
  {% else %}
    {% assign news_limit = news_size %}
  {% endif %}
  <ul class="flight-log flight-log--compact">
    {% for item in news limit: news_limit %}
      <li class="log-entry">
        <div class="log-date">{{ item.date | date: '%Y.%m.%d' }}</div>
        <div class="log-content">
          {% if item.inline %}
            <p>{{ item.content | strip_html | strip }}</p>
          {% else %}
            <a class="log-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="page-description">No news so far...</p>
{% endif %}
