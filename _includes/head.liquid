{% include metadata.liquid %}

{%- comment -%} self-hosted fonts (_includes/fonts.css): preload the latin files every page renders with {%- endcomment -%}
<link rel="preload" href="/assets/fonts/web/silkscreen-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/web/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
{% if page.url contains '/repositories' %}<link rel="preconnect" href="https://github-stats-git-main-mikhail-codes.vercel.app">{% endif %}

<!-- McMaster-Carr-style instant navigation: same-origin links get
     prerendered on hover/pointerdown in browsers that support the
     Speculation Rules API. -->
<script type="speculationrules">
{
  "prerender": [{
    "where": { "href_matches": "/*" },
    "eagerness": "moderate"
  }]
}
</script>

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url }}">
{% endif %}

{%- comment -%} the whole stylesheet (~5 KB gzipped) is compiled inline, so first paint never waits on a CSS request {%- endcomment -%}
{%- capture styles -%}@import "tokens", "base", "layout", "components";{%- endcapture -%}
<style>{% include fonts.css %}{{ styles | scssify }}</style>

<script data-cfasync="false">
  // theme cookie is shared with books.mikhail.codes; dark unless chosen otherwise
  document.documentElement.setAttribute('data-theme', (document.cookie.match(/(?:^|; )theme=(light|dark)/) || [])[1] || 'dark');
</script>
