<figure>
  <a class="figure-link" href="{{ include.path | relative_url }}" target="_blank" rel="noopener" title="Open full size">
    <img
      src="{{ include.path | relative_url }}"
      alt="{{ include.title | default: include.alt }}"
      loading="{{ include.loading | default: 'lazy' }}"
    >
  </a>
</figure>
